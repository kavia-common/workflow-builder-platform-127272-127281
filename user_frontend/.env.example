# Frontend configuration variables for user_frontend
# Copy this file to .env and set the values for your environment.

# Base URL of the backend API (e.g., http://localhost:8000/api)
REACT_APP_API_BASE_URL=

# Public key for Stripe, if used by the backend's client-side flows
REACT_APP_STRIPE_PUBLIC_KEY=

# QuickBooks Client ID for initiating OAuth (if the backend requires it to be exposed client-side)
REACT_APP_QUICKBOOKS_CLIENT_ID=

# Public site URL, used for redirects after auth/integrations (e.g., http://localhost:3000)
REACT_APP_SITE_URL=
